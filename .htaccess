DirectoryIndex index.html
Options -MultiViews

RewriteEngine On

# HTTPS
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# Página inicial
RewriteRule ^$ /inicio [R=301,L,NE]
RewriteRule ^index/?$ /inicio [R=301,L,NC,NE]

# Compatibilidade com URLs antigas
RewriteRule ^contato(?:\.html)?/?$ /orcamento [R=301,L,NC,NE]

# Remove .html de URLs públicas acessadas diretamente
RewriteCond %{THE_REQUEST} \s/+(.+?)\.html(?:[?\s]) [NC]
RewriteRule ^(.+)\.html$ /$1 [R=301,L,NE]

# Remove barra final em páginas (exceto diretórios reais)
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.+)/$ /$1 [R=301,L,NE]

# /inicio serve index.html
RewriteRule ^inicio$ index.html [L]

# Rotas sem extensão servem o .html correspondente
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{DOCUMENT_ROOT}/$1.html -f
RewriteRule ^(.+)$ $1.html [L]

# Cache básico para arquivos estáticos
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/webp "access plus 30 days"
</IfModule>
